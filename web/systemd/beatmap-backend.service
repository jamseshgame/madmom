[Unit]
Description=Jamsesh Beatmap API
After=network.target

[Service]
Type=exec
User=www-data
Group=www-data
WorkingDirectory=/opt/madmom/web/backend
EnvironmentFile=/opt/madmom/web/.env
# Jobs, asyncio tasks, and separator process handles are intentionally kept in
# one process. Multiple workers split that state and duplicate the sizeable ML
# runtime, making long Roformer jobs much more likely to be terminated.
ExecStart=/opt/madmom/web/backend/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 1
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
